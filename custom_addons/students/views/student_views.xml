<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="student_view_form" model="ir.ui.view">
        <field name="name">student.view.form</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="address"/>
                            <field name="city"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="student_view_list" model="ir.ui.view">
        <field name="name">student.view.list</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <list string="Student List">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="address"/>
                <field name="city"/>
            </list>
        </field>
    </record>
    <record id="student_view_search" model="ir.ui.view">
        <field name="name">student.view.search</field>
        <field name="model">student.student</field>
        <field name="arch" type="xml">
            <search string="Search Students">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <filter name="filter_phone"
                        string="Has Phone"
                        domain="[('phone', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="groupby_city"
                            string="City"
                            context="{'group_by': 'city'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>