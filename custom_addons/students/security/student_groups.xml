<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="module_category_student" model="ir.module.category">
        <field name="name">Student Management</field>
        <field name="description">Student Management Access Rights</field>
        <field name="sequence">30</field>
    </record>

    <!-- Student User -->
    <record id="student_group" model="res.groups">
        <field name="name">Student User</field>
        <field name="category_id" ref="module_category_student"/>
    </record>

    <!-- Student Administrator -->
    <record id="student_group_admin" model="res.groups">
        <field name="name">Student Administrator</field>
        <field name="category_id" ref="module_category_student"/>
        <field name="implied_ids" eval="[(4, ref('student_group'))]"/>
    </record>

</odoo>
