<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="student_group" model="res.groups">
            <field name="name">Student Group</field>
            <field name="category_id" ref="base.module_category_custom"/>
        </record>
        <record id="student_group_rule" model="ir.rule">
            <field name="name">Student Group Rule</field>
            <field name="model_id" ref="model_student"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('student_group'))]"/>
        </record>
    </data>
</odoo>